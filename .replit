modules = ["python-3.11"]
[deployment]
run = "DATABASE_URL=$neondb LD_LIBRARY_PATH=/home/runner/.nix-profile/lib PYTHONPATH=src .venv/bin/uvicorn k9overwatch.web.main:app --host 0.0.0.0 --port 8080"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[nix]
channel = "stable-25_05"
packages = ["libxcrypt", "postgresql", "rapidfuzz-cpp", "taskflow", "xcodebuild", "zlib", "gcc-unwrapped", "chromium"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pip install -q playwright playwright-stealth && python -m playwright install chromium --with-deps 2>/dev/null || true"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PYTHONPATH=src uvicorn k9overwatch.web.main:app --host 0.0.0.0 --port 5000 --reload"
waitForPort = 5000

[agent]
expertMode = true
