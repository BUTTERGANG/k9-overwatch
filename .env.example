# ── Database ────────────────────────────────────────────────────────────────
# Local SQLite (development / testing only):
DATABASE_URL=sqlite+aiosqlite:///data/k9overwatch.db

# ── Neon DB (recommended for production) ─────────────────────────────────────
# Replace the placeholder values with your Neon project connection string.
# Find it in the Neon console → your project → Connection Details → Connection string.
# The app automatically strips libpq-only params (sslmode, etc.) and translates
# them to asyncpg connect_args so you can paste the Neon URL directly.
#
# DATABASE_URL=postgresql://user:password@ep-xxxx-yyyy.us-east-1.aws.neon.tech/k9overwatch?sslmode=require
#
# Neon pooled connection (recommended for web workers — append "?pgbouncer=true" if using pooler endpoint):
# DATABASE_URL=postgresql://user:password@ep-xxxx-yyyy-pooler.us-east-1.aws.neon.tech/k9overwatch?sslmode=require

# ── Search center (defaults to Indianapolis downtown) ───────────────────────
SEARCH_LAT=39.7684
SEARCH_LON=-86.1581
SEARCH_RADIUS_MILES=25
SEARCH_ZIP=46201                    # ZIP code for sources that require it

# ── Geocoding ────────────────────────────────────────────────────────────────
GEOCODE_PROVIDER=nominatim          # nominatim | google
GOOGLE_MAPS_API_KEY=                # required if GEOCODE_PROVIDER=google
NOMINATIM_USER_AGENT=k9overwatch/1.0 (your@email.com)

# ── Rate limiting ─────────────────────────────────────────────────────────────
HTTP_RATE_LIMIT_SECONDS=1.5
PLAYWRIGHT_HEADLESS=true

# ── Admin authentication ──────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# ── Scheduler ─────────────────────────────────────────────────────────────────
RUN_SCHEDULER=true                  # set to true to run scrapers inside the web process

# ── Alerting ──────────────────────────────────────────────────────────────────
# Paste a Discord or Slack incoming webhook URL to receive alerts when a scraper
# fails 3+ consecutive times. Leave blank to disable (alerts still log to stdout).
ALERT_WEBHOOK_URL=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=pretty                   # pretty | json
